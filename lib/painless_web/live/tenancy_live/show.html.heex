<.header>
  Tenancy <%= @tenancy.id %>
  <:subtitle>This is a tenancy record from your database.</:subtitle>
  <:actions>
    <.link href="#tenancy-notes" class="text-sm font-semibold leading-6 text-zinc-900 hover:text-zinc-700">
      Notes
    </.link>
    <.link patch={~p"/tenancies/#{@tenancy}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit tenancy</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Name"><%= @tenancy.name %></:item>
  <:item title="Property"><%= @tenancy.property %></:item>
  <:item title="Notes"><%= @tenancy.notes %></:item>
  <:item title="Active"><%= @tenancy.active %></:item>
  <:item title="Recurring"><%= @tenancy.recurring %></:item>
  <:item title="Recurring description"><%= @tenancy.recurring_description %></:item>
  <:item title="Late fee"><%= @tenancy.late_fee %></:item>
  <:item title="Rent"><%= @tenancy.rent %></:item>
  <:item title="Rent day of month"><%= @tenancy.rent_day_of_month %></:item>
</.list>

<section id="tenancy-notes" class="mt-14">
  <.header>
    Tenancy notes
    <:subtitle>Dated notes from anyone on this tenancy.</:subtitle>
    <:actions>
      <.link patch={~p"/tenancies/#{@tenancy}/notes/new"}>
        <.button>Add note</.button>
      </.link>
    </:actions>
  </.header>

  <.table id="tenancy_notes" rows={@streams.tenancy_notes}>
    <:col :let={{_id, note}} label="Date">
      <%= format_note_date(note.noted_at) %>
      <span :if={note_edited?(note)} class="text-zinc-500"> (edited)</span>
    </:col>
    <:col :let={{_id, note}} label="Author">
      <span title={note.user.email}><%= format_note_author(note.user) %></span>
    </:col>
    <:col :let={{_id, note}} label="Note">
      <span class="whitespace-pre-wrap"><%= note.body %></span>
    </:col>
    <:action :let={{_id, note}}>
      <.link patch={~p"/tenancies/#{@tenancy}/notes/#{note}/edit"} title="Edit">
        <.icon name="hero-pencil-square" />
        <span class="sr-only">Edit</span>
      </.link>
    </:action>
    <:action :let={{id, note}}>
      <.link
        phx-click={JS.push("delete_note", value: %{id: note.id}) |> hide("##{id}")}
        data-confirm="Are you sure?"
        title="Delete"
      >
        <.icon name="hero-trash" />
        <span class="sr-only">Delete</span>
      </.link>
    </:action>
  </.table>
</section>

<.back navigate={~p"/tenancies"}>Back to tenancies</.back>

<.modal :if={@live_action == :edit} id="tenancy-modal" show on_cancel={JS.patch(~p"/tenancies/#{@tenancy}")}>
  <.live_component
    module={PainlessWeb.TenancyLive.FormComponent}
    id={@tenancy.id}
    title={@page_title}
    action={@live_action}
    tenancy={@tenancy}
    patch={~p"/tenancies/#{@tenancy}"}
  />
</.modal>

<.modal
  :if={@live_action in [:new_note, :edit_note]}
  id="tenancy-note-modal"
  show
  on_cancel={JS.patch(~p"/tenancies/#{@tenancy}")}
>
  <.live_component
    module={PainlessWeb.TenancyLive.NoteFormComponent}
    id={@note.id || :new}
    title={@page_title}
    action={@live_action}
    note={@note}
    tenancy={@tenancy}
    current_user={@current_user}
    patch={~p"/tenancies/#{@tenancy}"}
  />
</.modal>
